# Public hostname routed to this service by Dokploy/Traefik.
WEB_HOST=cd-solutions.example.com

# Optional image metadata.
VERSION=prod
REVISION=prod

# Contact details. CONTACT_EMAIL is also the contact-form recipient.
CONTACT_EMAIL=hello@cd-solutions.example.com
CONTACT_PHONE=+250 000 000 000
CONTACT_ADDRESS=Kigali, Rwanda

# Transactional email delivery through Resend.
RESEND_API_KEY=re_replace_with_your_api_key
CONTACT_FROM_EMAIL=CD Solutions <website@your-verified-domain.com>
